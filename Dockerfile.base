FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# README.md에 명시된 패키지들 설치
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libgl-dev \
    libglu1-mesa-dev \
    libglfw3-dev \
    libglew-dev \
    pkg-config \
    libxrandr-dev \
    libxinerama-dev \
    libxcursor-dev \
    libxi-dev \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 작업 디렉토리 설정
WORKDIR /app